# =============================================================
# Signal Radar — variáveis de ambiente obrigatórias
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA faça commit do .env com valores reais — apenas .env.example.
# =============================================================

# ----- Supabase -----------------------------------------------
# Obter em: supabase.com → seu projeto → Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-public-key>

# ----- Backend API --------------------------------------------
# URL base da API REST (ex: https://api.seudominio.com).
# OBRIGATÓRIA em produção — sem ela o cliente REST é bloqueado.
VITE_API_BASE_URL=http://localhost:3001/api

# URL do WebSocket (wss:// em produção, ws:// em desenvolvimento).
VITE_API_WS_URL=ws://localhost:3001

# ----- Bot4x --------------------------------------------------
# Habilita o motor REAL do Bot4x (true | false).
# Quando false ou ausente, o app roda inteiramente em modo DEMO
# (simulação client-side, sem ordens reais).
VITE_BOT4X_REAL_ENABLED=false

# ----- Email queue (server-only) ------------------------------
# Segredo exclusivo usado pelo pg_cron para chamar
# /lovable/email/queue/process. NUNCA reutilize SUPABASE_SERVICE_ROLE_KEY
# como credencial de API — ele dá acesso irrestrito ao banco.
# Gerar localmente: openssl rand -hex 32
EMAIL_QUEUE_CRON_SECRET=<random-256-bit-hex>

# ----- Observabilidade ----------------------------------------
# DSN público do Sentry (browser SDK). Pode ficar no bundle —
# é uma credencial publishable por design.
# Obter em: sentry.io → Settings → Projects → <project> → Client Keys (DSN).
# Sem essa variável, o Sentry vira no-op (apenas console).
VITE_SENTRY_DSN=

# ----- Cache TTLs (server-only) -------------------------------
# TTL em segundos para o cache compartilhado em `caches.default`
# (Cloudflare Workers Cache API). Valores baixos = dados mais frescos,
# valores altos = menos chamadas externas. Apenas server-side.
CACHE_TTL_PRICES_SECONDS=5
CACHE_TTL_SIGNALS_SECONDS=10
CACHE_TTL_SENTIMENT_SECONDS=60
